{
  "$schema": "./node_modules/oxlint/configuration_schema.json",

  // An array of glob patterns indicating the files that should not be linted.
  "ignorePatterns": [
    "src/**/*.js"
  ],

  "rules": {
    "no-unused-vars": [
      "warn",
      {
        "argsIgnorePattern": "^_"
      }
    ],

    // Not part of oxlint's default (correctness-only) rule set, so it has to be
    // named explicitly to keep failing the build as it did under typescript-eslint.
    "typescript/no-explicit-any": "error"
  }
}
