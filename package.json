  "name": "starter-item",
  "version": "0.0.1",
  "devDependencies": {
    "@changesets/cli": "^3.0.3",
    "@enonic-types/core": "^8.0.4",
    "@enonic-types/global": "^8.0.4",
    "@enonic-types/lib-admin": "^8.0.2",
    "@enonic-types/lib-app": "^8.0.2",
    "@enonic-types/lib-auditlog": "^8.0.2",
    "@enonic-types/lib-auth": "^8.0.4",
    "@enonic-types/lib-cluster": "^8.0.2",
    "@enonic-types/lib-common": "^8.0.2",
    "@enonic-types/lib-content": "^8.0.2",
    "@enonic-types/lib-context": "^8.0.4",
    "@enonic-types/lib-event": "^8.0.2",
    "@enonic-types/lib-export": "^8.0.4",
    "@enonic-types/lib-grid": "^8.0.2",
    "@enonic-types/lib-i18n": "^8.0.4",
    "@enonic-types/lib-io": "^8.0.2",
    "@enonic-types/lib-mail": "^8.0.2",
    "@enonic-types/lib-node": "^8.0.2",
    "@enonic-types/lib-portal": "^8.0.4",
    "@enonic-types/lib-project": "^8.0.2",
    "@enonic-types/lib-repo": "^8.0.2",
    "@enonic-types/lib-scheduler": "^8.0.2",
    "@enonic-types/lib-schema": "^8.0.2",
    "@enonic-types/lib-sse": "^8.0.2",
    "@enonic-types/lib-task": "^8.0.2",
    "@enonic-types/lib-value": "^8.0.2",
    "@enonic-types/lib-vhost": "^8.0.2",
    "@enonic-types/lib-websocket": "^8.0.2",
    "@item-enonic-types/lib-freemarker": "^4.0.0",
    "@item-enonic-types/lib-time": "^2.0.0",
    "@itemconsulting/storybook-framework-enonic-xp": "^0.2.0",
    "@itemconsulting/xp-storybook-utils": "^0.3.0",
    "@storybook/addon-a11y": "^10.6.4",
    "@storybook/addon-docs": "^10.6.4",
    "@storybook/addon-links": "^10.6.4",
    "@swc/core": "^1.15.43",
    "@swc/jest": "^0.2.39",
    "@types/node": "^26.0.0",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "cssnano": "^8.0.10",
    "glob": "^13.0.6",
    "jest": "^30.5.0",
    "jest-environment-jsdom": "^30.4.1",
    "oxlint": "^1.80.0",
    "postcss": "^8.5.31",
    "postcss-cli": "^12.0.0",
    "postcss-import": "^17.0.1",
    "postcss-nesting": "^14.0.3",
    "postcss-normalize": "^13.0.1",
    "postcss-reporter": "^7.1.0",
    "postcss-url": "^10.1.4",
    "prettier": "^3.9.10",
    "storybook": "^10.6.4",
    "tsdown": "^0.22.14",
    "typescript": "~7.0.2",
    "vite": "^8.3.5",
    "vitest": "^4.1.11"
  },
  "private": true,
  "scripts": {
    "build": "concurrently -c auto -g --timings npm:build:*",
    "build-storybook": "storybook build",
    "build:css": "postcss src/main/resources/assets/styles/main.css -m -d build/resources/main/assets/styles --base src/main/resources/assets/styles --ext min.css",
    "build:ts": "tsdown",
    "check": "concurrently -c auto -g --timings npm:check:types npm:lint",
    "check:types": "concurrently --kill-others-on-fail -g -r --timings npm:check:types:*",
    "check:types:client": "tsc --noEmit -p src/main/resources/assets/tsconfig.json",
    "check:types:server": "tsc --noEmit -p src/main/resources/tsconfig.json",
    "cov": "jest --no-cache --coverage",
    "format": "prettier --write \"src/**/*.{ts,css}\"",
    "lint": "oxlint src",
    "release": "npm run build",
    "storybook": "storybook dev -p 6006",
    "test": "jest --no-cache",
    "versioning": "changeset version && npm i --package-lock-only && node -e \"const fs=require('fs');const v=require('./package.json').version;fs.writeFileSync('gradle.properties',fs.readFileSync('gradle.properties','utf8').replace(/^version\\s*=.*$/m,'version = '+v))\""
  }
}
