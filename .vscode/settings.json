{
  // Never auto-import from the @enonic-types/* packages directly — they are
  // type stubs for the XP runtime libraries. Combined with the explicit
  // "/lib/xp/<name>" paths entries in src/main/resources/tsconfig.json, this
  // makes auto-import suggest the runtime-correct "/lib/xp/<name>" specifiers.
  "typescript.preferences.autoImportSpecifierExcludeRegexes": [
    "^@enonic-types/",
    "^@item-enonic-types/"
  ]
}
